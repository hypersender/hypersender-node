# hypersender-node SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: HYPERSENDER_
#
# Security environment variables:
HYPERSENDER_WHATSAPP_API_KEY=your_whatsappapikey_here
HYPERSENDER_SMS_API_KEY=your_smsapikey_here
HYPERSENDER_OTP_API_KEY=your_otpapikey_here
HYPERSENDER_ENTERPRISE_API_KEY=your_enterpriseapikey_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
HYPERSENDER_DEBUG=true
